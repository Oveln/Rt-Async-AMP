[submodule "rt-async"]
	path = rt-async
	url = git@github.com:Oveln/rt-async.git
[submodule "tgoskits"]
	path = tgoskits
	url = https://github.com/Oveln/tgoskits.git
	# 上游基线：Dirinkbottle/tgoskits dev-k3com260kit（K3 com260kit 板级适配来源）。
	# 开发分支 feat/rt-async-amp 基于 dev-k3com260kit + 本项目 rt-shm/AMP 工作，
	# push 到 Oveln/tgoskits（自己的 fork）。子模块内 origin=Oveln(可 push)，
	# upstream=Dirinkbottle(只 fetch)。url 必须指向 gitlink commit 所在仓库，
	# 即 Oveln fork（dev-k3com260kit 基线 + 本项目 cherry-pick 后的 commit 只在此）。
	branch = feat/rt-async-amp
[submodule "ov-channels"]
	path = modules/ov-channels
	url = git@github.com:Oveln/ov-channels.git
	# 上游即本人仓库（无 fork 关系），集成分支 main（v0.2.0 已发布）。
	# 开发分支 feat/rt-async-amp 基于 main，承载窗口原子 core 化补丁与
	# 后续 K3 跨核 SPSC 优化；主仓经根 Cargo.toml [patch.crates-io] 以
	# path 引用（子仓路径同时是 patch 源与 workspace member）。
	branch = feat/rt-async-amp
[submodule "opensbi-k3"]
	path = opensbi-k3
	url = git@github.com:Oveln/opensbi-spacemit.git
	# K3 板上固件源 = 官方 spacemit/opensbi tag k3-br-v1.0.0（yocto 配方
	# opensbi-k3_1.4.bb 同款钉点）。开发分支 feat/pma-audio-io 基于该 tag：
	# k3_defconfig 开 CONFIG_ENABLE_LOGGING（banner）+ spacemit_k3.c 每 hart
	# 运行时定位覆盖 AMP 窗（0xc0800000..0xc0880000，本板 boot ROM 表 =
	# entry4，vendor 固定写 byte6 实为写偏）翻 PMA IO=0x22——X100 硅忽略
	# Svpbmt 故 PMA 是唯一非缓存途径。托管同 tgoskits 模式：fork 仓
	# opensbi-spacemit 为 origin（可 push），upstream=spacemit 官方（只
	# fetch）；url 必须指向 gitlink commit 所在仓库（feat 分支只在 fork）。
	branch = feat/pma-audio-io
